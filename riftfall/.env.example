# ---------------------------------------------------------------- despliegue de contratos (Hardhat)
# Clave de la cuenta que paga el gas del despliegue (NUNCA la subas al repositorio).
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=
# Roles (direcciones). Recomendado: una multisig Safe para owner y tesorería.
RIFT_OWNER=
RIFT_TREASURY=
RIFT_SIGNER=
RIFT_OPERATOR=
RIFT_TEAM=
RIFT_LIQUIDITY=
RIFT_COMMUNITY=

# ---------------------------------------------------------------- servidor del juego
PORT=8787
HOST=0.0.0.0
DATA_DIR=./server/data
# Archivo generado por el despliegue (p. ej. deployments/84532.json para Base Sepolia).
DEPLOYMENT_FILE=
# RPC que usa el servidor (privado, p. ej. Alchemy/QuickNode) y el que se publica a los navegadores.
RPC_URL=
PUBLIC_RPC_URL=
EXPLORER_URL=https://sepolia.basescan.org
# Clave privada correspondiente a RIFT_SIGNER (firma vales y opera la Arena).
SIGNER_PRIVATE_KEY=
# Economía
RIFT_PER_SHARD=0.5
MIN_CLAIM_SHARDS=100
MIN_REALTIME_RATIO=0.9
# Arena automática (crea y liquida torneos diarios)
ARENA_AUTO=1
ARENA_FEE=100
ARENA_HOURS=24
ADMIN_TOKEN=cambia-esto-por-un-secreto-largo
# Solo para demos sin blockchain: permite probar todas las naves.
DEMO_SHIPS=0
